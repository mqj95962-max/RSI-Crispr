# Model training output folders — regenerate locally by rerunning the
# baseline script, don't version any of it (binaries or the CSV/JSON
# summaries). Covers both naming conventions in use:
#   <model_name>_ecoli/                          e.g. lightgbm_ecoli/
#   five_seed_champion_ecoli_<model_name>_baseline/
*_ecoli/
five_seed_champion_ecoli_*/

# Model artifacts by extension, in case an output folder doesn't match
# either pattern above.
*.pkl
*.npy

# Python cache
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
.ipynb_checkpoints/

# Reference genomes and other downloadable third-party data. Fetch them
# yourself rather than versioning them; Runjia/sgrna/README.md says where.
*.gb
*.fasta
*.fa
